# Copia questo file con il nome ".env" e compila i valori. Il file .env resta solo su questo PC:
# non va mai su GitHub (e' gia' escluso da .gitignore).
# Sul PC dove programmi lascia vuoti i dati di Telegram: i messaggi compaiono solo a schermo.

# Telegram: li scrive da solo il comando  python radar.py --telegram-setup
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# OpenRouter: chiave da https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modello (nome come su https://openrouter.ai/models): se c'e', vale questo e non quello scritto in llm.toml
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# facoltativo: un altro file per il modello al posto di llm.toml
# LLM_CONFIG=llm.toml

# Idealista: chiavi dell'API ufficiale, se te le danno (https://developers.idealista.com/access-request)
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
